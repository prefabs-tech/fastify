{
  "name": "@prefabs.tech/fastify-graphql",
  "version": "0.98.0",
  "description": "Fastify graphql plugin",
  "homepage": "https://github.com/prefabs-tech/fastify/tree/main/packages/graphql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefabs-tech/fastify.git",
    "directory": "packages/graphql"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/prefabs-tech-fastify-graphql.js",
      "require": "./dist/prefabs-tech-fastify-graphql.cjs"
    }
  },
  "main": "./dist/prefabs-tech-fastify-graphql.cjs",
  "module": "./dist/prefabs-tech-fastify-graphql.js",
  "types": "./dist/types/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "attw": "attw --pack . --ignore-rules false-esm",
    "build": "vite build && tsc --emitDeclarationOnly && mv dist/src dist/types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sort-package": "npx sort-package-json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "@graphql-tools/merge": "9.2.0",
    "@types/busboy": "1.5.4",
    "busboy": "1.6.0",
    "graphql-tag": "2.12.7",
    "graphql-upload-minimal": "1.6.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@prefabs.tech/eslint-config": "0.8.7",
    "@prefabs.tech/fastify-config": "0.98.0",
    "@prefabs.tech/fastify-slonik": "0.98.0",
    "@prefabs.tech/tsconfig": "0.10.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "10.7.0",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "graphql": "16.14.2",
    "mercurius": "16.10.0",
    "prettier": "3.9.5",
    "slonik": "46.8.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@prefabs.tech/fastify-config": "0.98.0",
    "@prefabs.tech/fastify-slonik": "0.98.0",
    "fastify": ">=5.10.0",
    "fastify-plugin": ">=5.1.0",
    "graphql": ">=16.14.2",
    "mercurius": ">=16.10.0",
    "slonik": ">=46.8.0",
    "zod": ">=3.25.76"
  },
  "engines": {
    "node": ">=22"
  }
}
