{
  "name": "@prefabs.tech/fastify-config",
  "version": "0.98.0",
  "description": "Fastify config plugin",
  "homepage": "https://github.com/prefabs-tech/fastify/tree/main/packages/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefabs-tech/fastify.git",
    "directory": "packages/config"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/prefabs-tech-fastify-config.js",
      "require": "./dist/prefabs-tech-fastify-config.cjs"
    }
  },
  "main": "./dist/prefabs-tech-fastify-config.cjs",
  "module": "./dist/prefabs-tech-fastify-config.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "attw": "attw --pack . --ignore-rules false-esm",
    "build": "vite build && tsc --emitDeclarationOnly && mv dist/src dist/types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sort-package": "npx sort-package-json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@prefabs.tech/eslint-config": "0.8.7",
    "@prefabs.tech/tsconfig": "0.10.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "10.7.0",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "pino": "10.3.1",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "fastify": ">=5.10.0",
    "fastify-plugin": ">=5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
