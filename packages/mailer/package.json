{
  "name": "@prefabs.tech/fastify-mailer",
  "version": "0.94.1",
  "description": "Fastify mailer plugin",
  "homepage": "https://github.com/prefabs-tech/fastify/tree/main/packages/mailer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prefabs-tech/fastify.git",
    "directory": "packages/mailer"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/prefabs-tech-fastify-mailer.js",
      "require": "./dist/prefabs-tech-fastify-mailer.cjs"
    }
  },
  "main": "./dist/prefabs-tech-fastify-mailer.cjs",
  "module": "./dist/prefabs-tech-fastify-mailer.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "docs/llm",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && mv dist/src dist/types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sort-package": "npx sort-package-json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "html-to-text": "10.0.0",
    "mustache": "4.2.0",
    "nodemailer": "9.0.3",
    "nodemailer-html-to-text": "3.2.0",
    "nodemailer-mjml": "1.6.0"
  },
  "devDependencies": {
    "@prefabs.tech/eslint-config": "0.8.7",
    "@prefabs.tech/fastify-config": "0.94.1",
    "@prefabs.tech/tsconfig": "0.8.7",
    "@types/mjml": "5.0.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/nodemailer-html-to-text": "3.1.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "10.7.0",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "mjml": "5.4.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@prefabs.tech/fastify-config": "0.94.1",
    "fastify": ">=5.10.0",
    "fastify-plugin": ">=5.1.0",
    "mjml": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "@prefabs.tech/fastify-config": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
